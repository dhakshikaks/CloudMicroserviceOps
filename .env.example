# Copy to .env and adjust as needed. Never commit the real .env file.
# POSTGRES_PASSWORD, GRAFANA_ADMIN_PASSWORD, and JWT_SECRET below all have
# development-only defaults baked into docker-compose.yml - set real values
# here before any deployment beyond your own machine.

# ---- Postgres (set a real password before deploying anywhere but localhost) ----
POSTGRES_DB=cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=change-me

# ---- Grafana (set a real password before deploying anywhere but localhost) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Auth (shared across backend and all business services) ----
# Set a real random 32+ byte secret before deploying anywhere but localhost.
JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret

# ---- Frontend origin ----
# The public URL you will open in a browser. Used by the backend for CORS,
# so it must match exactly (scheme + host + port).
#   Local (docker compose up on your own machine): the default below is correct.
#   Cloud (single EC2/VM):   FRONTEND_URL=http://<public-host>
#   Cloud (with a domain):   FRONTEND_URL=https://<domain>
FRONTEND_URL=http://localhost:3000

# ---- Frontend API routing (build-time only) ----
# The frontend talks only to its own origin - its Nginx reverse-proxies
# /api to the backend and /prometheus to Prometheus over the internal Docker
# network. These relative paths are correct for BOTH local and cloud
# deployment; leave them as-is unless the frontend is served from a
# different origin than backend/Prometheus.
VITE_API_BASE_URL=/api
VITE_PROMETHEUS_URL=/prometheus
