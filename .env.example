# Copy to .env and adjust as needed. Never commit the real .env file.

# ---- Postgres ----
POSTGRES_DB=cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=change-me

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Auth (shared across backend and all business services) ----
JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret
